.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Large inputs and generated outputs are reproducible, not source.
data/raw/
data/models/*.pt
artifacts/*/
!artifacts/.gitkeep

# Real datasets: 1.5 GB, reproducible from the sources documented in CLAUDE.md 7
raw_data/
data/raw/
data/models/*.pt

# Pipeline output, regenerated by scripts/run_demo.sh — EXCEPT the two
# incidents that cannot be regenerated without the 1.1 GB NRSC product. Those
# are the real-ISRO-data demonstration, they are ~16 MB together, and a clone
# without them can only show synthetic scenarios. audit.log stays out: the
# hash chain is verified within a run, not carried across checkouts.
artifacts/*
!artifacts/.gitkeep
!artifacts/kutch-exercise-001/
!artifacts/sat-dropin-eos04_kutch_water_hh/

# Calibrated EOS-04 rasters dropped in for replay: tens of MB, and regenerated
# from the NRSC product by `python -m samudra.ingest.eos04`. The sidecar JSON
# beside each one is the provenance record and is small enough to keep.
data/satellite/incoming/*.tif
!data/satellite/incoming/eos04_kutch_water_hh.tif

# Model checkpoints are ~154 MB each - over GitHub's 100 MB per-file hard
# limit, so a push containing one is rejected outright. They are build output,
# not source: retrain with scripts/train_segmenter.py, or attach them to a
# GitHub Release and link from the README.
*.pt
training_runs/**/*.pt
